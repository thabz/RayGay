; Compatibility helpers for scripts/gay2scm.py.
(load "raygay.scm")
(define legacy-add add-to-scene)
(define (legacy-group thunk)
  (let ((saved legacy-add) (items '()))
    (set! legacy-add (lambda (item) (set! items (cons item items))))
    (thunk)
    (set! legacy-add saved)
    (reverse items)))
(define (legacy-clone item)
  (if (list? item) (map legacy-clone item) (scene-object-copy item)))
(define (legacy-flatten items)
  (if (null? items) '()
      (append (if (list? (car items)) (legacy-flatten (car items)) (list (car items)))
              (legacy-flatten (cdr items)))))
(define (legacy-union items . material)
  (apply make-union (append (legacy-flatten items) material)))
(define (legacy-extrusion path radius segments pieces material)
  (make-extrusion path (make-circle #(0 0 0) radius #(0 0 1))
                  5 segments pieces material))
